# ─── HTTP / OAuth server (only needed for http-server mode) ────────────────────
PORT=3000
PUBLIC_URL=http://localhost:3000
# HS256 signing key for MCP JWTs — generate with: openssl rand -hex 32
MCP_JWT_SECRET=
# Override iFood refresh endpoint (default: https://www.ifood.com.br/site-api/v1/auth/token)
IFOOD_REFRESH_URL=

# ─── stdio mode / dev fallback ─────────────────────────────────────────────────
# iFood Bearer JWT token (extract from browser DevTools → Network → any request → authorization header)
IFOOD_ACCESS_TOKEN=

# User account UUID (visible in account_id request header or x-ifood-user-id)
IFOOD_ACCOUNT_ID=

# Device ID (x-ifood-device-id header)
IFOOD_DEVICE_ID=

# Session ID (x-ifood-session-id header)
IFOOD_SESSION_ID=

# Client application key (x-client-application-key header) — usually fixed
IFOOD_CLIENT_KEY=41a266ee-51b7-4c37-9e9d-5cd331f280d5

# API credentials for cart operations (access_key / secret_key headers from cart requests)
IFOOD_ACCESS_KEY=
IFOOD_SECRET_KEY=

# Device payment secret (x-ifood-device-payment-secret header, required for checkout)
IFOOD_DEVICE_PAYMENT_SECRET=
